# At work Vault agent renders these into the process environment. labctl and opsd read the same names.
# The lab needs none of them: the defaults point at the local brokers and Cruise Control.

KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:19093,localhost:19094
CRUISE_CONTROL_URL=http://localhost:9090
# The opsd container already publishes 127.0.0.1:8090. Use another port to run bin/opsd beside it.
OPSD_ADDR=127.0.0.1:8091

# MSK with SASL/SCRAM (port 9096)
# KAFKA_TLS=true
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# MSK with IAM (port 9098). Short-lived credentials, for example from Vault's AWS secrets engine.
# KAFKA_TLS=true
# KAFKA_SASL_MECHANISM=AWS_MSK_IAM
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
